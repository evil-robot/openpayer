{
  "name": "openpayer-ingest",
  "git_source": {
    "git_url": "https://github.com/evil-robot/openpayer",
    "git_provider": "gitHub",
    "git_branch": "main"
  },
  "environments": [
    {
      "environment_key": "Default",
      "spec": { "environment_version": "4" }
    }
  ],
  "tasks": [
    {
      "task_key": "ingest",
      "spark_python_task": {
        "python_file": "databricks/ingest_job.py",
        "source": "GIT"
      },
      "environment_key": "Default",
      "timeout_seconds": 14400
    }
  ],
  "parameters": [
    { "name": "limit", "default": "40" }
  ],
  "format": "MULTI_TASK"
}
