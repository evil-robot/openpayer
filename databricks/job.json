{
  "name": "openpayer-ingest",
  "git_source": {
    "git_url": "https://github.com/evil-robot/openpayer",
    "git_provider": "gitHub",
    "git_branch": "main"
  },
  "environments": [
    {
      "environment_key": "Default",
      "spec": { "environment_version": "4" }
    }
  ],
  "tasks": [
    {
      "task_key": "ingest",
      "spark_python_task": {
        "python_file": "databricks/ingest_job.py",
        "source": "GIT",
        "parameters": ["--limit={{job.parameters.limit}}", "--only={{job.parameters.only}}", "--workers={{job.parameters.workers}}", "--group-cap={{job.parameters.group_cap}}", "--smallest-first={{job.parameters.smallest_first}}"]
      },
      "environment_key": "Default",
      "timeout_seconds": 0
    }
  ],
  "parameters": [
    { "name": "limit", "default": "60" },
    { "name": "only", "default": "" },
    { "name": "workers", "default": "1" },
    { "name": "group_cap", "default": "300" },
    { "name": "smallest_first", "default": "" }
  ],
  "schedule": {
    "quartz_cron_expression": "0 0 11 1 * ?",
    "timezone_id": "UTC",
    "pause_status": "UNPAUSED"
  },
  "max_concurrent_runs": 1,
  "email_notifications": {
    "on_failure": ["jas@medtruth.care"],
    "no_alert_for_skipped_runs": true
  },
  "format": "MULTI_TASK"
}
