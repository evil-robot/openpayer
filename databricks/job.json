{
  "name": "openpayer-ingest",
  "git_source": {
    "git_url": "https://github.com/evil-robot/openpayer",
    "git_provider": "gitHub",
    "git_branch": "main"
  },
  "environments": [
    {
      "environment_key": "Default",
      "spec": { "environment_version": "4" }
    }
  ],
  "tasks": [
    {
      "task_key": "ingest",
      "spark_python_task": {
        "python_file": "databricks/ingest_job.py",
        "source": "GIT",
        "parameters": ["--limit={{job.parameters.limit}}", "--only={{job.parameters.only}}", "--workers={{job.parameters.workers}}", "--group-cap={{job.parameters.group_cap}}"]
      },
      "environment_key": "Default",
      "timeout_seconds": 14400
    }
  ],
  "parameters": [
    { "name": "limit", "default": "" },
    { "name": "only", "default": "" },
    { "name": "workers", "default": "3" },
    { "name": "group_cap", "default": "300" }
  ],
  "format": "MULTI_TASK"
}
